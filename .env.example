# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values.  `.env` is gitignored, so your
# token never gets committed:   cp .env.example .env
# Restart `npm run dev` (site) and `npx sanity dev` (Studio) after editing.
# ─────────────────────────────────────────────────────────────────────────────

# === Sanity Visual Editing (Presentation / click-to-edit) ===

# A token that can read drafts AND the preview-secret docs. Create it at:
#   https://sanity.io/manage  →  project "u4uyfix8"  →  API  →  Tokens  →  Add token
#   IMPORTANT: use **Editor** permissions, not Viewer — Viewer cannot read the
#   sanity.previewUrlSecret documents, so the preview check fails. (Server-side
#   only, never exposed to the browser.)
SANITY_VIEWER_TOKEN=

# The running website origin the Studio embeds for the preview iframe. Also
# where the Studio's "Retraduzir" document action sends its fetch.
#   Local dev:  http://localhost:5173      Production:  https://your-deployed-site
#   Keep local Studio and local website on the same hostname (`localhost`, not mixed
#   with `127.0.0.1`) because preview cookies are host-scoped.
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:5173

# The Studio URL used for stega click-to-edit deep links (workspace basePath is /website).
# Also read server-side (as SANITY_STUDIO_URL) by /api/sanity/translate to
# allow-list the Studio's origin for the "Retraduzir" button's CORS request.
#   Local dev:  http://localhost:3333/website   Deployed: https://<your-studio>.sanity.studio/website
SANITY_STUDIO_URL=http://localhost:3333/website

# === Sanity content maintenance/imports ===

# Public website dataset read by the SvelteKit app. Keep this equal to
# SANITY_STUDIO_DATASET when testing Presentation/click-to-edit locally.
SANITY_DATASET=production

# Dataset used by the local Studio website workspace. Point this to a separate
# development dataset only when you intentionally do not want local content edits
# to touch the live `production` dataset.
SANITY_STUDIO_DATASET=production

# Optional local isolation switch:
# - SANITY_DISABLE_REMOTE=true makes the website render only in-code fallback data.
SANITY_DISABLE_REMOTE=false

# Optional short server cache for published Sanity collection reads. Preview mode
# bypasses this cache so Studio Presentation stays live.
SANITY_COLLECTION_CACHE_MS=15000

# Token with update access for controlled content maintenance scripts such as
# `npm run import:store-images`, and also used server-side by the translation
# pipeline (/api/sanity/translate, npm run seed:translation-hashes) to write
# EN/ES content back. Create at sanity.io/manage with Editor permissions on
# the `production` dataset. Keep this server/local only.
SANITY_WRITE_TOKEN=

# Signs the short-lived, httpOnly iframe session used by the standalone
# `/painel/site` builder preview. Generate an independent random value with
# `openssl rand -base64 32`. If omitted, the server falls back to a Sanity
# server token, but a dedicated secret is preferred in production.
BUILDER_PREVIEW_SECRET=

# === Translation (DeepL auto-translate: PT -> EN/ES) ===

# DeepL API key. Free tier keys end in ":fx" (500k chars/month); the SDK
# auto-selects the free vs. pro API host from this suffix. Get one at
# https://www.deepl.com/pro-api
#
# This is now only the fallback default. An admin can swap the active key
# at runtime from /painel/definicoes (stored in Postgres, app_settings) when
# the free plan's character limit is reached — no redeploy needed. The
# override always wins over this env var when one is set.
DEEPL_API_KEY=

# English target variant DeepL should translate into. DeepL requires a
# regional variant for English (bare "EN" is rejected as a target).
# Defaults to en-US if unset.
DEEPL_TARGET_EN=en-US

# Optional DeepL glossary IDs for terminology approved by the business. Context
# already disambiguates common website terms; glossaries are the final authority
# for product names or terminology that must always use one exact translation.
DEEPL_GLOSSARY_EN=
DEEPL_GLOSSARY_ES=

# Verifies that incoming POSTs to /api/sanity/translate genuinely came from
# the Sanity webhook. Set at sanity.io/manage -> project -> API -> Webhooks
# -> (create/edit the translate webhook) -> Secret, using the same value.
SANITY_WEBHOOK_SECRET=

# Shared secret for the Studio's manual "Retraduzir" document action button.
# Must be set to the IDENTICAL value here and as SANITY_STUDIO_TRANSLATE_SECRET
# on the Studio's own deployment (it's publicly bundled into the Studio's
# static build, so it must never be a real write credential — only capable of
# triggering a retranslation of a single document by id).
SANITY_STUDIO_TRANSLATE_SECRET=

# === Temporary Railway preview administrator ===

# Preview/staging only. When enabled, the first /painel request creates or
# refreshes a marked administrator account in Postgres. Disabling the flag
# automatically deactivates that account and removes its active sessions.
# Never leave this enabled for the final public launch.
PREVIEW_ADMIN_ENABLED=false
PREVIEW_ADMIN_NAME=Administrador de preview
PREVIEW_ADMIN_USERNAME=admin
PREVIEW_ADMIN_PASSWORD=

# === Private ecommerce / orders ===

# Railway Postgres connection string. Required for customer accounts, checkout
# and /painel/encomendas. Run `npm run db:migrate` after provisioning it.
DATABASE_URL=

# Public origin used in transactional email links.
APP_ORIGIN=http://localhost:5173

# Resend transactional email. EMAIL_FROM must be a verified Resend sender/domain.
# If omitted, checkout still creates a pending order but no emails are sent.
RESEND_API_KEY=
EMAIL_FROM=
ORDERS_TO_EMAIL=

# Ifthenpay PayByLink is intentionally fail-closed until credentials, endpoint,
# callback URLs and status mapping are confirmed.
IFTHENPAY_BACKOFFICE_KEY=
IFTHENPAY_PAYBYLINK_ENDPOINT=
