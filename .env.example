# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values.  `.env` is gitignored, so your
# token never gets committed:   cp .env.example .env
# Restart `npm run dev` (site) and `npx sanity dev` (Studio) after editing.
# ─────────────────────────────────────────────────────────────────────────────

# === Sanity Visual Editing (Presentation / click-to-edit) ===

# A token that can read drafts AND the preview-secret docs. Create it at:
#   https://sanity.io/manage  →  project "u4uyfix8"  →  API  →  Tokens  →  Add token
#   IMPORTANT: use **Editor** permissions, not Viewer — Viewer cannot read the
#   sanity.previewUrlSecret documents, so the preview check fails. (Server-side
#   only, never exposed to the browser.)
SANITY_VIEWER_TOKEN=

# The running website origin the Studio embeds for the preview iframe.
#   Local dev:  http://localhost:5173      Production:  https://your-deployed-site
#   Keep local Studio and local website on the same hostname (`localhost`, not mixed
#   with `127.0.0.1`) because preview cookies are host-scoped.
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:5173

# The Studio URL used for stega click-to-edit deep links (workspace basePath is /website).
#   Local dev:  http://localhost:3333/website   Deployed: https://<your-studio>.sanity.studio/website
SANITY_STUDIO_URL=http://localhost:3333/website

# === Sanity content maintenance/imports ===

# Public website dataset read by the SvelteKit app. Keep this equal to
# SANITY_STUDIO_DATASET when testing Presentation/click-to-edit locally.
SANITY_DATASET=production

# Dataset used by the local Studio website workspace. Point this to a separate
# development dataset only when you intentionally do not want local content edits
# to touch the live `production` dataset.
SANITY_STUDIO_DATASET=production

# Optional local isolation switch:
# - SANITY_DISABLE_REMOTE=true makes the website render only in-code fallback data.
SANITY_DISABLE_REMOTE=false

# Optional short server cache for published Sanity collection reads. Preview mode
# bypasses this cache so Studio Presentation stays live.
SANITY_COLLECTION_CACHE_MS=15000

# Token with update access for controlled content maintenance scripts such as
# `npm run import:store-images`. Keep this server/local only.
SANITY_WRITE_TOKEN=

# === Private CRM / staff backoffice ===

# Private Sanity dataset for legacy contact/catalogue CRM records and staff users.
SANITY_CRM_DATASET=crm

# Server-only token with write access to the private CRM dataset.
SANITY_CRM_WRITE_TOKEN=

# Long random secret used to hash staff sessions, rate-limit keys and CRM PII
# hashes. Required when the private CRM/backoffice is enabled.
CRM_HASH_SECRET=

# === Private ecommerce / orders ===

# Railway Postgres connection string. Required for customer accounts, checkout
# and /painel/encomendas. Run `npm run db:migrate` after provisioning it.
DATABASE_URL=

# Public origin used in transactional email links.
APP_ORIGIN=http://localhost:5173

# Resend transactional email. EMAIL_FROM must be a verified Resend sender/domain.
# If omitted, checkout still creates a pending order but no emails are sent.
RESEND_API_KEY=
EMAIL_FROM=
ORDERS_TO_EMAIL=

# Ifthenpay PayByLink is intentionally fail-closed until credentials, endpoint,
# callback URLs and status mapping are confirmed.
IFTHENPAY_BACKOFFICE_KEY=
IFTHENPAY_PAYBYLINK_ENDPOINT=
